{
  "manifest_version": 3,
  "name": "Save to litman",
  "version": "1.0.0",
  "description": "Save paper metadata and PDF from journal pages to litman",
  "permissions": ["activeTab", "downloads", "storage"],
  "host_permissions": ["https://api.crossref.org/*", "http://localhost:51780/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
